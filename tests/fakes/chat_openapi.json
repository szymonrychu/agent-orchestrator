        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "status": {
            "enum": [
              "queued",
              "sending",
              "sent"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "id",
          "status"
        ],
        "title": "SendAccepted",
        "type": "object"
